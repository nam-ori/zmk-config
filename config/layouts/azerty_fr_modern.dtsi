// Adapted from https://github.com/JeffDess/zmk-config/blob/main/layouts/canadian-multilingual-standard.dtsi
#undef CONFIG_ZMK_MACRO_DEFAULT_WAIT_MS
#define CONFIG_ZMK_MACRO_DEFAULT_WAIT_MS 30

#undef CONFIG_ZMK_MACRO_DEFAULT_TAP_MS
#define CONFIG_ZMK_MACRO_DEFAULT_TAP_MS 40

/* French Modern Mappings for Linux ("AZERTY, variante")
 * & Windows ("Français (Standard, AZERTY)") 
 * 
 * CD_ is for Combined diacritic - dead keys waiting to be combined
 */

#define FR_A    Q            // A
#define FR_Z    W            // Z
#define FR_Q    A            // Q
#define FR_W    Z            // W
#define FR_M    SEMI         // M
#define FR_0    LS(N0)       // 0
#define FR_1    LS(N1)       // 1
#define FR_2    LS(N2)       // 2
#define FR_3    LS(N3)       // 3
#define FR_4    LS(N4)       // 4
#define FR_5    LS(N5)       // 5
#define FR_6    LS(N6)       // 6
#define FR_7    LS(N7)       // 7
#define FR_8    LS(N8)       // 8
#define FR_9    LS(N9)       // 9
#define SLSH    SQT          // /
#define SQUO    MINUS        // '
#define DQUO    LS(MINUS)    // "
#define APO     N8           // ’
#define DEG     RA(MINUS)    // °
#define LBRAC   RA(T)        // {
#define RBRAC   RA(Y)        // }
#define LBKET   RA(N5)       // [
#define RBKET   RA(N6)       // ]
#define QUEST   LS(M)        // ?
#define PIP     RA(L)        // |
#define CD_TILDS  RA(N)     // ~*
#define LETHAN RA(NUBS)     // ≤
#define GRTHAN RA(LS(NUBS)) // ≥
#define CD_ACC_CU RA(N2)    // ´*
#define CD_ACC_CI EQUAL     // ^*
#define CD_ACC_GR RA(N3)    // `*
#define CD_ACC_TR LS(EQUAL) // ¨*
#define LTH     NUBS        // <
#define GTH     LS(NUBS)    // >
#define DOLL    RA(D)       // $
#define EUR     RA(E)       // €
#define PERC    RA(P)       // %
#define AROB    GRAVE       // @
#define ESPR    RA(N4)      // &
#define STR     NUHS        // *
#define EURO    RA(E)       // €
#define LPAREN  N5          // (
#define RPAREN  N6          // )
#define BSLSH   RA(N8)      // \
#define PLS     RBKT        // +
#define MINS    LBKT        // -
#define UNDSC   RA(N8)      // _
#define SHARP   LS(GRAVE)   // #
#define EXCLM   LS(COMMA)   // !
#define SEMIC   SLASH       // ;
#define CLN     DOT         // :
#define PERD    M           // .
#define COMM    COMMA       // ,
#define NBSPC   RA(SPACE)   // espace insécable
#define T_DOT   LS(DOT)     // …
#define INV_QUEST RA(M)     // ¿
#define INV_EXCL RA(COMMA)  // ¡
#define A_AGRAV N1          // à
#define E_ACUTE N2          // é
#define E_AGRAV N3          // è
#define E_ATREM N4          // ê
#define U_AGRAV RA(U)       // ù
#define FR_OE   RA(O)       // œ
#define FR_AE   RA(A)       // æ
#define C_CEDIL RA(C)       // ç

/* Fractions */
#define MATH_1_4 RA(LS(NUHS)) // ¼
#define MATH_1_2 LS(NUHS) // ½
// #define MATH_3_4 RC(N6)   // ¾


/* Symbols */
#define MATH_PM    LS(RBKT)  // ±
#define MATH_DEG   RA(MINUS) // °
#define MATH_MICRO LS(NUHS)  // µ

/* Typography */
#define LAQUO N9 // «
#define RAQUO N0 // »

// MOD-MORPH - lowercase / uppercase accented characters
// NOTE: Only accents accessed with a dead key on french keyboard need to have this mod-morph
// Otherwise the shift key will be pressed before the macro and will not be registering
ZMK_MOD_MORPH(morph_a_circ, bindings = <&kp CD_ACC_CI FR_A>, <&kp CD_ACC_CI LS(FR_A)>; mods = <(MOD_LSFT|MOD_RSFT)>;)  // â / Â
ZMK_MOD_MORPH(morph_e_trem, bindings = <&kp CD_ACC_TR E>, <&kp CD_ACC_TR LS(E)>; mods = <(MOD_LSFT|MOD_RSFT)>;)  // ë / Ë
ZMK_MOD_MORPH(morph_i_circ, bindings = <&kp CD_ACC_CI I>, <&kp CD_ACC_CI LS(I)>; mods = <(MOD_LSFT|MOD_RSFT)>;)  // î / Î
ZMK_MOD_MORPH(morph_i_trem, bindings = <&kp CD_ACC_TR I>, <&kp CD_ACC_TR LS(I)>; mods = <(MOD_LSFT|MOD_RSFT)>;)  // ï / Ï
ZMK_MOD_MORPH(morph_o_circ, bindings = <&kp CD_ACC_CI O>, <&kp CD_ACC_CI LS(O)>; mods = <(MOD_LSFT|MOD_RSFT)>;)  // ô / Ô
ZMK_MOD_MORPH(morph_o_trem, bindings = <&kp CD_ACC_TR O>, <&kp CD_ACC_TR LS(O)>; mods = <(MOD_LSFT|MOD_RSFT)>;)  // ö / Ö
ZMK_MOD_MORPH(morph_u_circ, bindings = <&kp CD_ACC_CI U>, <&kp CD_ACC_CI LS(U)>; mods = <(MOD_LSFT|MOD_RSFT)>;)  // û / Û
ZMK_MOD_MORPH(morph_u_grav, bindings = <&kp CD_ACC_GR U>, <&kp CD_ACC_GR LS(U)>; mods = <(MOD_LSFT|MOD_RSFT)>;)  // ù / Ù
ZMK_MOD_MORPH(morph_u_trem, bindings = <&kp CD_ACC_TR U>, <&kp CD_ACC_TR LS(U)>; mods = <(MOD_LSFT|MOD_RSFT)>;)  // ü / Ü

// ACCENTS MACROS

/* Accents without letter */
ZMX_MACRO_ONE_PARAM(cd_to_acc, bindings =
    <&macro_param_1to1>,
    <&macro_tap &kp MACRO_PLACEHOLDER SPACE>;
)

#define TILDS   &cd_to_acc CD_TILDS   // *
#define ACC_CU  &cd_to_acc CD_ACC_CU  // *
#define ACC_CI  &cd_to_acc CD_ACC_CI  // *
#define ACC_GR  &cd_to_acc CD_ACC_GR  // *
#define ACC_TR  &cd_to_acc CD_ACC_TR  // *
