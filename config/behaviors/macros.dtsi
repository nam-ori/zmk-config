// Adapted from https://github.com/JeffDess/zmk-config/blob/main/behaviors/macros.dtsi


// ACCENTS MACROSZMK_AUTO_LAYER
// Accents without letter (dead char -> "alive" char)
ZMK_MACRO_ONE_PARAM(alive,
    wait-ms = <40>;
    tap-ms = <40>; 
    bindings =
    <&macro_param_1to1>,
    <&kp MACRO_PLACEHOLDER>,
    <&kp SPACE>;
)

// UPPER POSITION LETTERS - POWER NUMBER etc.
ZMK_MACRO_ONE_PARAM(pwr, 
    wait-ms = <40>;
    tap-ms = <40>;
    bindings =
        <&kp CD_ACC_CI>,
        <&macro_param_1to1>,
        <&kp MACRO_PLACEHOLDER>;
)

// KEYMAP MACROS
// The following macros return to the specified layer after being pressed

// General - intended for accents layer(s)
// (name = Key press (kp) once (1) then go back to layer)
ZMK_MACRO_TWO_PARAM(kp1, bindings = 
    <&macro_param_1to1>, 
    <&kp MACRO_PLACEHOLDER>, 
    <&macro_param_2to1>, 
    <&to MACRO_PLACEHOLDER>;
)
// For any character but back to Ergo-L layer so from ErgoAcc
// (name = Key press (kp) once (1) then go back to layer)
ZMK_MACRO_ONE_PARAM(kp1e, bindings = 
    <&macro_param_1to1>, 
    <&kp MACRO_PLACEHOLDER>, 
    <&to ERG>;
)
// Circ acc ^
ZMK_MACRO_ONE_PARAM(ci, bindings = 
    <&macro_param_1to1>, 
    <&kp CD_ACC_CI &kp MACRO_PLACEHOLDER>;
)
ZMK_MACRO_TWO_PARAM(ci1, bindings = 
    <&macro_param_1to1>, 
    <&kp CD_ACC_CI &kp MACRO_PLACEHOLDER>, 
    <&macro_param_2to1>, 
    <&to MACRO_PLACEHOLDER>;
)
// Trema "
ZMK_MACRO_ONE_PARAM(tr, bindings = 
    <&macro_param_1to1>, 
    <&kp CD_TREMA &kp MACRO_PLACEHOLDER>;
)
ZMK_MACRO_TWO_PARAM(tr1, bindings = 
    <&macro_param_1to1>, 
    <&kp CD_TREMA &kp MACRO_PLACEHOLDER>, 
    <&macro_param_2to1>, 
    <&to MACRO_PLACEHOLDER>;
)
