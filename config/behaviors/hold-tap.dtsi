// Adapted from https://github.com/JeffDess/zmk-config/blob/main/behaviors/hold_tap.dtsi
#define std_tap_term 200
#define quick_tap 200
#define long_tap_term 300
#define hrm_prior_idle 100

&mt {
  tapping-term-ms = <long_tap_term>;
  quick-tap-ms = <quick_tap>;
};

&lt{
  tapping-term-ms = <std_tap_term>;
  quick-tap-ms = <quick_tap>;
};

// space or narrow no-break space and layer if hold
ZMK_HOLD_TAP(n_space_lt,
    flavor = "balanced";
    quick-tap-ms = <quick_tap>;
    tapping-term-ms = <long_tap_term>;
    bindings = <&mo>, <&nnbspac>;
)

// space or narrow no-break space and key press if hold
ZMK_HOLD_TAP(n_space_mt,
    flavor = "balanced";
    quick-tap-ms = <quick_tap>;
    tapping-term-ms = <long_tap_term>;
    bindings = <&kp>, <&nnbspac>;
)

//  backspace or del and layer if hold
ZMK_HOLD_TAP(del_lt,
    flavor = "balanced";
    quick-tap-ms = <quick_tap>;
    tapping-term-ms = <std_tap_term>;
    bindings = <&mo>, <&bspc_del>;
)

//  backspace or del and key press if hold
ZMK_HOLD_TAP(del_mt,
    flavor = "balanced";
    quick-tap-ms = <quick_tap>;
    tapping-term-ms = <std_tap_term>;
    bindings = <&kp>, <&bspc_del>;
)

ZMK_HOLD_TAP(sticky,
    flavor = "tap-preferred";
    tapping-term-ms = <long_tap_term>;
    bindings = <&kp>, <&sk>;
    hold-while-undecided-linger;
)


/* Timerless Home Row Mods */
/* https://github.com/urob/zmk-config#timeless-homerow-mods */

/* left-hand HRMs */
ZMK_HOLD_TAP(hml,
    flavor = "tap-preferred";
    tapping-term-ms = <long_tap_term>;
    quick-tap-ms = <quick_tap>;
    require-prior-idle-ms = <hrm_prior_idle>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

/* right-hand HRMs */
ZMK_HOLD_TAP(hmr,
    flavor = "tap-preferred";
    tapping-term-ms = <long_tap_term>;
    quick-tap-ms = <quick_tap>;
    require-prior-idle-ms = <hrm_prior_idle>;
    bindings = <&kp>, <&kp>;
//    hold-trigger-key-positions = <KEYS_L THUMBS>;
//    hold-trigger-on-release;
)

// baserow mods for 0 (Ergo-L on Azerty)
ZMK_HOLD_TAP(hrm_decim_e,
