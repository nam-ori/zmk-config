#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/totem.h"

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                          // thumbs

// Modifier keys
#define GL LGUI
#define CL LCTRL
#define AL LALT
#define SL LSHFT
#define GR RGUI
#define CR RCTRL
#define AR RALT
#define SR RSHFT

// Layers
// Must match order in which they are defined
#define ERG 0
#define EAC 1
#define SYM 2
#define NAV 3
#define NUM 4
#define GAM 5

// Keys
#define ___ &trans
#define XXX &none
#define BACK &to ERG

#include "layouts/azerty_fr_modern.dtsi"

#include "behaviors/macros.dtsi"
#include "behaviors/mod-morph.dtsi"
#include "behaviors/hold-tap.dtsi"
#include "behaviors/combos_totem.dtsi"

// KEYMAP MACROS
// The following macros return to the specified layer after being pressed
// kp1 = key press once (1) only then back
ZMK_MACRO_ONE_PARAM(kp1, bindings = <&macro_param_1to1>, <&kp MACRO_PLACEHOLDER>, <&to ERG>;)
ZMK_MACRO(A_CI1, bindings = <&a_circ>, <&to ERG>;)     // Â
ZMK_MACRO(E_TR1, bindings = <&e_trem>, <&to ERG>;)     // Ë
ZMK_MACRO(I_CI1, bindings = <&i_circ>, <&to ERG>;)     // Î
ZMK_MACRO(I_TR1, bindings = <&i_trem>, <&to ERG>;)     // Ï
ZMK_MACRO(O_CI1, bindings = <&o_circ>, <&to ERG>;)     // Ô
ZMK_MACRO(O_TR1, bindings = <&o_trem>, <&to ERG>;)     // Ö
ZMK_MACRO(U_CI1, bindings = <&u_circ>, <&to ERG>;)     // Û
ZMK_MACRO(U_TR1, bindings = <&u_trem>, <&to ERG>;)     // Ü

ZMK_MACRO(E_CU1, bindings = <&e_cute>, <&to ERG>;)     // É
ZMK_MACRO(E_GR1, bindings = <&e_grav>, <&to ERG>;)     // È
ZMK_MACRO(E_CI1, bindings = <&e_circ>, <&to ERG>;)     // Ê
ZMK_MACRO(A_GR1, bindings = <&a_grav>, <&to ERG>;)     // À


ZMK_LAYER(ErgoL,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &kp FR_Q    &kp C       &kp O       &kp P        &kp FR_W       &kp J       &kp FR_M      &kp D         &eac_exl     &kp Y
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
               &hml GL FR_A  &hml AL S   &hml CL E   &hml SL N    &kp F          &kp L       &hmr SR R     &hmr CL T     &hmr AR I    &hmr GL U
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     &kp LCTRL   &kp FR_Z    &kp X       &min_qst    &kp V        &kp B          &dot_col    &kp H         &kp G         &comma_semi  &kp K        &kp LALT
// ╰───────────├───────────┴───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         &kp LSHFT   &lt NAV RET  &lt NUM ESC    &bspc_del   &lt SYM SPACE &mt RALT TAB
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

ZMK_LAYER(ErgoAcc,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &A_CI1     &kp1 C_CEDIL &kp1 FR_OE  &O_CI1       BACK           BACK      &kp1 MATH_MICRO &kp1 UNDSC    &trem_gr1    BACK
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &A_GR1      &E_CU1      &E_GR1   &hrm_ECIRC SL 0 BACK           BACK        &kp SL        &I_TR1        &U_CI1       &kp1 U_AGRAV
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         &A_CI1      BACK        BACK       BACK          BACK           BACK        BACK          BACK          BACK         BACK         ___
// ╰───────────├───────────┴───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          BACK           ___         ___           ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

ZMK_LAYER(Symbols,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &circacc    &lessert    &greatert   &dollars     &perct         &arobase    &kp ESPR      &starmul      &squotecute  &graveacc
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                &lbracecaron &kp LPAREN  &kp RPAREN  &rbraceupoin &equalordif    &bslashobl  &plusplusm    &hyphenminm   &slashdiv    &dquotecute
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         &tildes     &lbracketc  &rbracketo  &underscruh  &kp SHARP      &kp VPIP    &kp EXCLM     &semicolced   &coloneach   &questionm   ___
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          &lt NUM ESC    ___         ___           ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

ZMK_LAYER(Nav,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                &out OUT_TOG &bt BT_NXT  XXX         &kp C_NEXT   &kp C_VOL_UP   XXX         XXX           XXX           XXX          XXX
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &sk LGUI    &bt BT_PRV  XXX         &kp C_PREV   &kp C_VOL_DN   &kp LEFT    &kp DOWN      &kp UP        &kp RIGHT    &kp INS
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___      &bt BT_CLR_ALL &bt BT_CLR  XXX         &kp C_PP     &kp C_MUTE     &kp HOME    &kp PG_DN     &kp PG_UP     &kp END      &kp SLCK     ___
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___            ___         ___           ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

ZMK_LAYER(Numbers,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &kp F1      &kp F2      &kp F3      &kp F4       &kp MATH_PM   &kp MATH_1_4 &d7           &d8           &d9          &multi_div
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &kp F5      &kp F6      &kp F7      &hml SL F8   &kp DEG       &kp MATH_1_2 &d4           &d5           &d6          &plus_minus
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         &kp F9      &kp F10     &kp F11     &kp F12    &kp MATH_MICRO  XXX          &d1           &d2           &d3          &comma_dot   ___
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___            ___         &d0           &kp DOT
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

ZMK_LAYER(Game,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &kp TAB     &kp Q       &kp W       &kp E        &kp R          XXX         XXX           XXX           XXX          &kp AL
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &kp SL      &kp A       &kp S       &kp D        &kp F          &kp N1      &kp N2        &kp N3        &kp N4       &kp N5
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     &kp SL      &kp CL      &kp Z       &kp X       &kp C        &kp V          &kp N6      &kp N7        &kp N8        &kp N9       &kp N0       XXX
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         &kp ESC     &kp SPACE    &kp RET        &kp ESC     &kp M         XXX
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)
