// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄


#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// Modifier keys - shortcuts for the layers bindings
#define   GL  LGUI
#define   CL  LCTRL
#define   AL  LALT
#define   SL  LSHFT
#define   GR  RGUI
#define   CR  RCTRL
#define   AR  RALT
#define   SR  RSHFT

// Layers
#define   ERL   0
#define   ERG   1
#define   NUM   2
#define   NUA   3
#define   SYM   4
#define   FCT   5
#define   EAC   6
#define   GAM   7

// Keys
#define   ___       &trans
#define   BACK_EAC  &to ERG
#define   PBREAK    PAUSE_BREAK

#include "layouts/azerty-fr-modern.dtsi"
#include "layouts/ergol.dtsi"
#include "behaviors/one-dead-key.dtsi"
#include "behaviors/capsword.dtsi"
#include "behaviors/macros.dtsi"
#include "behaviors/mod-morph.dtsi"
#include "behaviors/hold-tap.dtsi"
#include "behaviors/combos-totem.dtsi"
#include "behaviors/conditional-layers.dtsi"

/ {
  keymap {
    compatible = "zmk,keymap";
    
    // Computer-managed layer - QWERTY-based sent keys, adapted per activated layout on OS
    // Best with Ergo-L because NavNum accessed from here is maped for Ergo-L
    ErgolBase {
      display-name = "ERL";
      bindings = <
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &kp Q       &kp W       &kp E       &kp R        &kp T          &kp Y       &kp U         &kp I         &odk_kp O    &kp P
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &hrm SL A   &hrm GL S   &hrm CL D   &hrm AL F    &kp G          &kp  H      &hrm AL J     &hrm CR K     &hrm GR L    &hrm SR SEMI
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     &kp CL      &kp Z       &kp X       &kp C       &kp V        &kp B          &kp N       &kp M         &kp COMMA     &kp PERIOD   &kp SLASH    &kp AL
// ╰───────────├───────────┴───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                        &lt FCT ESC  &bsk SL SL   &lt NUM RET   &lt NUM BSPC &mt AR SPACE  &mt AR TAB
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
      >;
    };

    // AZERTY-based sent keys, Ergo-L emulated
    ErgolAz {
      display-name = "ERG";
      bindings = <
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &kp FR_Q    &kp C       &kp O       &kp P        &kp FR_W       &kp J       &kp FR_M      &kp D         &eac_exl     &kp Y
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                &hrm SL FR_A &hrm GL S   &hrm CL E   &hrm AL N    &kp F          &kp L       &hrm AL R     &hrm CR T     &hrm GR I    &hrm SR U
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         &kp FR_Z    &kp X       &min_qst    &kp V        &kp B          &dot_col    &kp H         &kp G         &comma_semi  &kp K        ___
// ╰───────────├───────────┴───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___         &lt NUM BSPC &n_space_lt SYM 0 ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
      >;
    };

    // Ergo-L-based sent keys
    NavNumBase {
      display-name = "NUM";
      bindings = <
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &kp TAB     &kp HOME    &kp UP      &kp END      &kp PG_UP     &multi_dive  &kp N7        &kp N8        &kp N9       &comma_dote
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
              &hrm SL CAPS &hrm GL LEFT &hrm CL DOWN &hrm AL RIGHT &kp PG_DN    &plus_minuse &hrm AL N4    &hrm CR N5    &hrm GR N6 &hrm_decim_e SR 0
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         &kp SLCK    &kp PBREAK  &kp INS     &kp DEL      &kp K_APP      &kp N0      &kp N1        &kp N2        &kp N3       &equal_e     ___
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___            &kp BSPC    ___           ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
      >;
    };

    // AZERTY-based sent keys, Ergo-L emulated
    // must be activated with NUM under it (done with conditional_layers)
    NavNumAz {
      display-name = "NUA";
      bindings = <
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 ___         ___         ___         ___          ___           &multi_diva  &d7           &d8           &d9          &comma_dota
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 ___         ___         ___         ___          ___           &plus_minusa &hrm_d4 AL 0 &hrm_d5 CR 0 &hrm_d6 GR 0 &hrm_decim_a SR 0
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         ___         ___         ___         ___          ___            &d0         &d1           &d2           &d3          &equal_a     ___
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___            ___      &n_space_mt AR 0 ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
      >;
    };

    // AZERTY-based sent keys, Ergo-L emulated
    // AltGr emulation
    Symbols {
      display-name = "SYM";
      bindings = <
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &circacc    &lessert    &greatert   &dollars     &perct         &arobase    &kp ESPR      &starmul      &squotecute  &graveacc
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
         &hrmlbrace SL 0 &hrm AL LPAREN &hrm GL RPAREN &hrmrbrace CL 0 &equaldif &bslashobl &hrmplus CR 0 &hrmhyphen GR 0 &hrmslash AL 0 &hrmdquote SR 0
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         &tildes     &lbracketc  &rbracketo  &underscruh  &kp SHARP      &kp VPIP    &kp EXCLM     &semicolced   &coloneach   &questionm   ___
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___            ___         &nbspac       ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
      >;
    };

    Funct {
      display-name = "FCT";
      bindings = <
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                &kp LA(F4) &bt BT_SEL 3 &bt BT_SEL 2 &kp C_NEXT  &kp C_VOL_UP   &kp C_BRI_UP &kp F1        &kp F2        &kp F3       &kp F4
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                &out OUT_TOG &bt BT_NXT &bt BT_SEL 1 &kp C_PREV  &kp C_VOL_DN   &kp C_BRI_DN &kp F5        &kp F6        &kp F7       &kp F8
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___      &bt BT_CLR_ALL &bt BT_CLR &bt BT_SEL 0 &kp C_PP     &kp C_MUTE     &kp PSCRN   &kp F9        &kp F10       &kp F11      &kp F12      ___
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___            &mt AL BSPC &kp SPACE     ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
      >;
    };

    // AZERTY-based sent keys, Ergo-L emulated
    // One-Dead-Key emulation
    ErgAzAcc {
      display-name = "EAC";
      bindings = <
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &ACI       &kp C_CEDIL  &kp FR_OE   &OCI         BACK_EAC       BACK_EAC    &kp MATH_MIC  &kp UNDSC     &trem_gr     &UCI
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &AGR        &ECU        &EGR        &ECI         BACK_EAC       &kp LPAREN  &kp RPAREN    &ICI          &ITR         &kp U_AGRAV
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         &kp FR_AE   &kp S_SHARP &nob_hyph   &kp NDASH    &kp MDASH      &kp T_DOT   &kp M_DOT     &kp GREEK     &kp M_DOT    BACK_EAC     ___
// ╰───────────├───────────┴───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         BACK_EAC    ___          BACK_EAC       BACK_EAC    &kp APO       ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
      >;
    };

    Game {
      display-name = "GAM";
      bindings = <
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &kp TAB     &kp Q       &kp W       &kp E        &kp R          &kp PBREAK  &kp PSCRN    &kp F5        &kp F6       &kp F7
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &kp SL      &kp A       &kp S       &kp D        &kp F          &kp N1      &kp N2        &kp N3        &kp N4       &kp N5
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     &kp T       &kp CL      &kp Z       &kp X       &kp C        &kp V          &kp N6      &kp N7        &kp N8        &kp N9       &kp N0       &kp AL
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         &kp ESC     &kp SPACE    &kp RET        &kp BSPC    &kp FR_M      &kp L
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
      >;
    };
    
  };
};
