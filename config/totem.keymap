#include <dt-bindings/zmk/keys.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/totem.h"

// https://github.com/urob/zmk-config/tree/main#timeless-homerow-mods
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                          // thumbs

// Modifier keys
#define GL LGUI
#define CL LCTRL
#define AL LALT
#define SL LSHFT
#define GR RGUI
#define CR RCTRL
#define AR RALT
#define SR RSHFT

// Layers
// Must match order in which they are defined
#define ERL 0
#define ERG 1
#define NUM 2
#define NUA 3
#define SYM 4
#define FCT 5
#define EAC 6
#define GAM 7

// Keys
#define ___ &trans
#define BACK_EAC &to ERG
#define PBREAK PAUSE_BREAK

#include "layouts/azerty-fr-modern.dtsi"
#include "layouts/ergol.dtsi"
#include "behaviors/leader-key.dtsi"
#include "behaviors/capsword.dtsi"
#include "behaviors/macros.dtsi"
#include "behaviors/mod-morph.dtsi"
#include "behaviors/hold-tap.dtsi"
#include "behaviors/combos-totem.dtsi"
#include "behaviors/conditional-layers.dtsi"

&sk {
    quick-release;
};


// Computer-managed layer - QWERTY-based sent keys, adapted per activated layout on OS
// Best with Ergo-L because NavNum accessed from here is maped for Ergo-L
// ERL
ZMK_LAYER(ErgolBase,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &kp Q       &kp W       &kp E       &hml AL R    &kp T          &kp Y       &kp U         &kp I         &odk_kp O    &kp P
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &kp A       &hml AL S   &hml GL D   &hml CL F    &kp G          &kp  H      &hmr CR J     &hmr GR K     &hmr AL L    &kp SEMI
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     &kp CL      &kp Z       &kp X       &kp C       &kp V        &kp B          &kp N       &kp M         &kp COMMA     &kp PERIOD   &kp SLASH    &kp AL
// ╰───────────├───────────┴───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                        &lt FCT ESC &sticky SL SL &lt NUM RET   &lt NUM BSPC &mt AR SPACE  &mt AR TAB
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

// ERG
ZMK_LAYER(ErgolAz,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &kp FR_Q    &kp C       &kp O       &hml AL P    &kp FR_W       &kp J       &kp FR_M      &kp D         &eac_exl     &kp Y
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &kp FR_A    &hml AL S   &hml GL E   &hml CL N    &kp F          &kp L       &hmr CR R     &hmr GR T     &hmr AL I    &kp U
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         &kp FR_Z    &kp X       &min_qst    &kp V        &kp B          &dot_col    &kp H         &kp G         &comma_semi  &kp K        ___
// ╰───────────├───────────┴───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___         &lt NUM BSPC &n_space_lt SYM 0 ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

// NUM
ZMK_LAYER(NavNumBase,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &kp TAB     &kp HOME    &kp UP      &hml AL END  &kp PG_UP     &multi_dive  &kp N7        &kp N8        &kp N9       &comma_dote
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &kp CAPS    &kp LEFT    &kp DOWN    &kp RIGHT    &kp PG_DN     &plus_minuse &kp N4        &kp N5        &kp N6       &kp KP_DOT
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         &kp SLCK  &hml AL PBREAK &hml GL INS &hml CL DEL &kp K_APP      &kp N0      &hmr CR N1    &hmr GR N2    &hmr AL N3   &equal_oble  ___
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___            &kp BSPC    ___           ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────, type: held╯
)

// NUA
ZMK_LAYER(NavNumAz,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 ___         ___         ___         ___          ___           &multi_diva  &d7           &d8           &d9          &comma_dota
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 ___         ___         ___         ___          ___           &plus_minusa &d4           &d5           &d6        &hmr GR KP_DOT 
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         ___         ___         ___         ___          ___            &d0        &hrm_d1 SR 0  &hrm_d2 CR 0 &hrm_d3 AL 0 &equal_obla ___
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___            ___      &n_space_mt AR 0 ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

// SYM
ZMK_LAYER(Symbols,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &circacc    &lessert    &greatert   &dollars     &perct         &arobase    &kp ESPR      &starmul      &squotecute  &graveacc
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
          &lbracecar &hml AL LPAREN &hml GL RPAREN &hmlrbrace CL 0 &equalordif &bslashobl &hmrplus CR 0 &hmrhyphen GR 0 &hmrslash AL 0 &dquotecute
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         &tildes     &lbracketc  &rbracketo  &underscruh  &kp SHARP      &kp VPIP    &kp EXCLM     &semicolced   &coloneach   &questionm   ___
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___            ___         &nbspac       ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

// FCT
ZMK_LAYER(Function,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                &kp LA(F4) &bt BT_SEL 3 &bt BT_SEL 2 &kp C_NEXT  &kp C_VOL_UP   &kp C_BRI_UP &kp F1        &kp F2        &kp F3       &kp F4
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                &out OUT_TOG &bt BT_NXT &bt BT_SEL 1 &kp C_PREV  &kp C_VOL_DN   &kp C_BRI_DN &kp F5        &kp F6        &kp F7       &kp F8
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___      &bt BT_CLR_ALL &bt BT_CLR &bt BT_SEL 0 &kp C_PP     &kp C_MUTE    &kp PSCRN    &kp F9        &kp F10       &kp F11      &kp F12      ___
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         ___         ___          ___           &del_mt AL 0 &kp SPACE     ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

// EAC
ZMK_LAYER(ErgAzAcc,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &ACI       &kp C_CEDIL  &kp FR_OE   &OCI         BACK_EAC       BACK_EAC    &kp MATH_MIC  &kp UNDSC     &trem_gr     &UCI
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &AGR        &ECU        &EGR     &hrm_ECIRC SL 0 BACK_EAC       &kp LPAREN &hmr SR RPAREN &ICI         &ITR         &kp U_AGRAV
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     ___         &kp FR_AE   &kp S_SHARP &nob_hyph   &kp NDASH    &kp MDASH      &kp T_DOT   &kp M_DOT     &kp GREEK     &kp M_DOT    BACK_EAC     ___
// ╰───────────├───────────┴───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         BACK_EAC    ___          BACK_EAC       BACK_EAC    &kp APO       ___
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)

// GAM
ZMK_LAYER(Game,
//             ╭───────────┬───────────┬───────────┬────────────┬────────────╮ ╭───────────┬─────────────┬─────────────┬────────────┬────────────╮
                 &kp TAB     &kp Q       &kp W       &kp E        &kp R          &kp PBREAK  &kp PSCRN    &kp F5        &kp F6       &kp F7
//             ├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤
                 &kp SL      &kp A       &kp S       &kp D        &kp F          &kp N1      &kp N2        &kp N3        &kp N4       &kp N5
// ╭───────────├───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┼────────────┤────────────╮
     &kp T       &kp CL      &kp Z       &kp X       &kp C        &kp V          &kp N6      &kp N7        &kp N8        &kp N9       &kp N0       &kp AL
// ╰───────────┴───────────┼───────────┼───────────┼────────────┼────────────┤ ├───────────┼─────────────┼─────────────┼────────────┴────────────┴────────────╯
                                         &kp ESC     &kp SPACE    &kp RET        &kp BSPC    &kp FR_M      &kp L
//                                     ╰───────────┴────────────┴────────────╯ ╰───────────┴─────────────┴─────────────╯
)
